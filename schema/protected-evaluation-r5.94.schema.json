{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R5.94 protected evaluation provenance policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["classification", "activation_scope", "frc_version", "clarification_modes", "states"],
  "properties": {
    "classification": {"const": "PROTECTED_EVALUATION"},
    "activation_scope": {"const": "PROTECTED_HELD_OUT_EVALUATION"},
    "frc_version": {"const": "FormalRequirementContract-protected-0.1"},
    "clarification_modes": {"const": ["HUMAN_AVAILABLE", "UNAVAILABLE_TERMINATE", "PREAUTHORIZED_AUTHORITY"]},
    "states": {"const": ["PRISTINE", "AUTHORIZED_NOT_ACCESSED", "SOURCE_ADMITTED", "FORMALIZATION_EXPOSED", "REVIEW_EXPOSED", "AUTHOR_EXPOSED", "DEVELOPMENT_EXPOSED"]}
  }
}
