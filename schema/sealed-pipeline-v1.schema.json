{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lykoi sealed-pipeline-1 executable run manifest",
  "description": "Controller additionally recomputes identities, dependency coherence, native analysis and current component pins.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "frc", "what_seal", "structural", "structural_receipt", "bdi", "adequacy", "v1", "plan_seal", "components", "run", "fixture"],
  "properties": {
    "version": {"const": "sealed-pipeline-1"},
    "frc": {"type": "string", "minLength": 1},
    "what_seal": {"type": "string", "minLength": 1},
    "structural": {"type": "string", "minLength": 1},
    "structural_receipt": {"type": "string", "minLength": 1},
    "bdi": {"type": "string", "minLength": 1},
    "adequacy": {"type": "string", "minLength": 1},
    "v1": {"type": "string", "minLength": 1},
    "plan_seal": {"type": "string", "minLength": 1},
    "components": {"type": "string", "minLength": 1},
    "run": {"type": "string", "minLength": 1},
    "fixture": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
