# Bulk observations automatically use LFS for every round and results subdirectory.
# Compact candidates, locks, manifests, comparisons and reports remain regular Git.
benchmark/results/**/*-EVIDENCE*.json filter=lfs diff=lfs merge=lfs -text
benchmark/results/**/*-B[0-9][0-9]-RESULT.json filter=lfs diff=lfs merge=lfs -text

# Keep new audit metadata/tool hashes stable across Windows and Unix checkouts.
benchmark/artifacts/*.py text eol=lf
benchmark/artifacts/*.json text eol=lf
benchmark/artifacts/*.md text eol=lf
