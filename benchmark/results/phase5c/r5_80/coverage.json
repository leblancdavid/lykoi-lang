{
  "kind": "R5.80-code-point-source-locators",
  "sources": {
    "S01": {
      "source_commitment": "c48ad01a00bf9e25515c287969db99ea370db10cf1b024d23d0a7b6fb3eae9f4",
      "fragments": [
        {
          "start": 0,
          "end": 45,
          "text": "Given two integers x and y, return their sum.",
          "obligations": [
            "S01.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 46,
          "end": 89,
          "text": "No state or external effects are permitted.",
          "obligations": [
            "S01.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S02": {
      "source_commitment": "ac69d2da1da33ac7adda44e96d736106175914ebb226229d490c6a38bab5aea7",
      "fragments": [
        {
          "start": 0,
          "end": 57,
          "text": "Create a note with a caller-supplied unique key and text.",
          "obligations": [
            "S02.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 58,
          "end": 92,
          "text": "Reading that key returns its text.",
          "obligations": [
            "S02.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 93,
          "end": 134,
          "text": "Updating that key replaces only its text.",
          "obligations": [
            "S02.O03"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 135,
          "end": 169,
          "text": "Deleting that key makes it absent.",
          "obligations": [
            "S02.O04"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 170,
          "end": 199,
          "text": "Other notes remain unchanged.",
          "obligations": [
            "S02.O05"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 200,
          "end": 253,
          "text": "Behavior for absent or duplicate keys is unspecified.",
          "obligations": [],
          "disposition": "EXPLICIT_UNSPECIFIED_BEHAVIOR"
        }
      ],
      "active_issues": []
    },
    "S03": {
      "source_commitment": "0967401dde425737ed3310010a8cf445e35cfd1e057bcb215391ae32399cabbb",
      "fragments": [
        {
          "start": 0,
          "end": 145,
          "text": "Given a sequence of records with name and active fields, return exactly the active records, sorted by name in ascending Unicode code-point order.",
          "obligations": [
            "S03.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 146,
          "end": 183,
          "text": "Equal names retain their input order.",
          "obligations": [
            "S03.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 184,
          "end": 208,
          "text": "Do not change the input.",
          "obligations": [
            "S03.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": [
        "S03.I1"
      ]
    },
    "S04": {
      "source_commitment": "9fdeb7a8db965d4a9f9f6fba29d67c0076993b6d04154a7ec9a95946c61288a6",
      "fragments": [
        {
          "start": 0,
          "end": 132,
          "text": "Given an ASCII string, remove leading and trailing ASCII space characters and convert A through Z to a through z; return the result.",
          "obligations": [
            "S04.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 133,
          "end": 163,
          "text": "Internal spaces are unchanged.",
          "obligations": [
            "S04.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S05": {
      "source_commitment": "7fda0f43675b8ae6b0a9ca62af6c12e3076215cc66bf37e880463201f0f5a3e6",
      "fragments": [
        {
          "start": 0,
          "end": 21,
          "text": "A ticket starts OPEN.",
          "obligations": [
            "S05.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 22,
          "end": 85,
          "text": "Closing an OPEN ticket changes it to CLOSED and returns CLOSED.",
          "obligations": [
            "S05.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 86,
          "end": 154,
          "text": "Closing a CLOSED ticket returns ALREADY_CLOSED and changes no state.",
          "obligations": [
            "S05.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 155,
          "end": 179,
          "text": "No other ticket changes.",
          "obligations": [
            "S05.O03"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 180,
          "end": 218,
          "text": "Tickets must always be OPEN or CLOSED.",
          "obligations": [
            "S05.O03"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S06": {
      "source_commitment": "fc685eb84ef0edeb9c9d3b48ad316d457f7ede6d45804c4b0c9a7443c3a22e80",
      "fragments": [
        {
          "start": 0,
          "end": 46,
          "text": "Store a supplied integer under a supplied key.",
          "obligations": [
            "S06.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 47,
          "end": 151,
          "text": "A later read of that key, including after process restart, returns the last successfully stored integer.",
          "obligations": [
            "S06.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 152,
          "end": 235,
          "text": "If storage fails, return STORAGE_ERROR and preserve all previously readable values.",
          "obligations": [
            "S06.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 236,
          "end": 273,
          "text": "The storage engine is not prescribed.",
          "obligations": [],
          "disposition": "IMPLEMENTATION_FREEDOM"
        }
      ],
      "active_issues": []
    },
    "S07": {
      "source_commitment": "18ebd9b7e5b795c798db0f56df6dd07ff61b9c79b1fdda2ce226acfb51319948",
      "fragments": [
        {
          "start": 0,
          "end": 154,
          "text": "Given an object with an optional nullable integer value, return ABSENT when value is omitted, NULL when it is explicitly null, and that integer otherwise.",
          "obligations": [
            "S07.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 155,
          "end": 198,
          "text": "Return INVALID for any other present value.",
          "obligations": [
            "S07.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 199,
          "end": 244,
          "text": "Produce no state changes or external effects.",
          "obligations": [
            "S07.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S08": {
      "source_commitment": "158a1236db619ca515eadbe78fd3a79317b7795fb95f7bb5d006fbec9adb5028",
      "fragments": [
        {
          "start": 0,
          "end": 22,
          "text": "Return the best tasks.",
          "obligations": [
            "S08.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": [
        "S08.I1"
      ]
    },
    "S09": {
      "source_commitment": "d59d53125000eac7148f2c72f2f1d03968ad044ff78eac64d4d3af7e20d5a891",
      "fragments": [
        {
          "start": 0,
          "end": 114,
          "text": "For every input sequence of names, return all names in insertion order and always sorted alphabetically ascending.",
          "obligations": [
            "S09.O01",
            "S09.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": [
        "S09.I1"
      ]
    },
    "S10": {
      "source_commitment": "f29538afedf9d2ce61b861007b67886a665c8c51a72c9932ad2f58685613d65a",
      "fragments": [
        {
          "start": 0,
          "end": 44,
          "text": "For a positive integer n, return n plus one.",
          "obligations": [
            "S10.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S11": {
      "source_commitment": "b979a08985f7b887c2fd1aaceca486f44204e267a9df373a782756df97a53ac2",
      "fragments": [
        {
          "start": 0,
          "end": 162,
          "text": "Given a sequence of integers and a nonnegative integer limit, return at most limit positive values in their original order, taking the earliest qualifying values.",
          "obligations": [
            "S11.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 163,
          "end": 207,
          "text": "Return an empty sequence when limit is zero.",
          "obligations": [
            "S11.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 208,
          "end": 232,
          "text": "Do not mutate the input.",
          "obligations": [
            "S11.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": []
    },
    "S12": {
      "source_commitment": "6ff55454ae7fd79065472881d3b58c0c4e33558574794e73712d875f06ce2f1a",
      "fragments": [
        {
          "start": 0,
          "end": 114,
          "text": "On an accepted reservation, reduce available seats by the requested positive count and return the remaining count.",
          "obligations": [
            "S12.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 115,
          "end": 184,
          "text": "Accept only when the requested count does not exceed available seats.",
          "obligations": [
            "S12.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 185,
          "end": 234,
          "text": "Otherwise return INSUFFICIENT and change nothing.",
          "obligations": [
            "S12.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 235,
          "end": 274,
          "text": "Available seats must never be negative.",
          "obligations": [
            "S12.O03"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 275,
          "end": 352,
          "text": "Emit exactly one confirmation to the caller on success and none on rejection.",
          "obligations": [
            "S12.O04"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": [
        "S12.I1"
      ]
    },
    "B01": {
      "source_commitment": "b7b2d714db5cee566e9e55982dd4c4d95d3d57f0c341e04ba1e15c24e9a8e94d",
      "fragments": [
        {
          "start": 0,
          "end": 91,
          "text": "# B01 — Critical priority (local)\n\nAdd `CRITICAL` above `HIGH` to accepted task priorities.",
          "obligations": [
            "B01.O01",
            "B01.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 92,
          "end": 173,
          "text": "`create --priority\nCRITICAL` persists and returns that value; `list` includes it.",
          "obligations": [
            "B01.O03",
            "B01.O04"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 174,
          "end": 219,
          "text": "`list-high`\ncontinues to mean exactly `HIGH`.",
          "obligations": [
            "B01.O05",
            "B01.O06"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 220,
          "end": 294,
          "text": "Existing LOW, NORMAL and HIGH tasks retain\ntheir values through migration.",
          "obligations": [
            "B01.O07"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 295,
          "end": 339,
          "text": "A missing priority still defaults to NORMAL.",
          "obligations": [
            "B01.O08"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        }
      ],
      "active_issues": [
        "B01.I1"
      ]
    },
    "P01": {
      "source_commitment": "fd639b585aa08edadfa8690ee26e9d96ff48a0c322075866bb32a21cd0bde650",
      "fragments": [
        {
          "start": 0,
          "end": 170,
          "text": "Use the complete public optional-measurement application and configuration supplied in component context 838669f4814f2ddfdcc9a9e22da58104f3643e570e1ac17f28e6607d02b9ca2b.",
          "obligations": [],
          "disposition": "EXPLICIT_COMPONENT_CONTEXT"
        },
        {
          "start": 171,
          "end": 221,
          "text": "Require public state alternatives for route store.",
          "obligations": [
            "P01.O01"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 222,
          "end": 334,
          "text": "Require exactly the supplied durable content constraints for V1, including value domain null or 17 when present.",
          "obligations": [
            "P01.O02"
          ],
          "disposition": "OBLIGATION_QUOTE_OVERLAP_REQUIRES_COVERAGE_REVIEW"
        },
        {
          "start": 335,
          "end": 387,
          "text": "No additional supplemental obligations are required.",
          "obligations": [],
          "disposition": "EXPLICIT_SUPPLEMENTAL_SCOPE"
        }
      ],
      "active_issues": []
    }
  },
