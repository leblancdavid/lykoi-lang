{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lykoi:r6.62:common:1",
  "$defs": {
    "artifact": {"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "identity": {"type":"object","additionalProperties":false,"required":["episode","source","frc","family","component"],"properties":{"episode":{"type":"string","minLength":1},"source":{"$ref":"#/$defs/artifact"},"frc":{"$ref":"#/$defs/artifact"},"family":{"type":"string","minLength":1},"component":{"type":"string","minLength":1}}},
    "profile": {"type":"object","additionalProperties":false,"required":["name","contract","foundation"],"properties":{"name":{"type":"string","minLength":1},"contract":{"$ref":"#/$defs/artifact"},"foundation":{"$ref":"#/$defs/artifact"}}},
    "context": {"type":"object","additionalProperties":false,"required":["messages","state","interface"],"properties":{"messages":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["role","content"],"properties":{"role":{"enum":["system","user","assistant","tool"]},"content":{"type":"string","minLength":1}}}},"state":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/artifact"}]},"interface":{"$ref":"#/$defs/artifact"}}},
    "evidence": {"type":"object","additionalProperties":false,"required":["status","target_source","validation","acceptance","observations","admission"],"properties":{"status":{"const":"QUALIFIED"},"target_source":{"$ref":"#/$defs/artifact"},"validation":{"$ref":"#/$defs/artifact"},"acceptance":{"$ref":"#/$defs/artifact"},"observations":{"$ref":"#/$defs/artifact"},"admission":{"$ref":"#/$defs/artifact"}}},
    "provenance": {"type":"object","additionalProperties":false,"required":["class","trace","limitations"],"properties":{"class":{"enum":["verified_endpoint","deterministic_expert_demonstration","observed_ai_trajectory"]},"trace":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/artifact"}]},"limitations":{"type":"array","items":{"type":"string"}}}},
    "partition": {"type":"object","additionalProperties":false,"required":["split","export","ledger"],"properties":{"split":{"enum":["training_development","validation_development","evaluation_only"]},"export":{"enum":["training_allowed","evaluation_only"]},"ledger":{"$ref":"#/$defs/artifact"}},"allOf":[{"if":{"properties":{"split":{"const":"evaluation_only"}}},"then":{"properties":{"export":{"const":"evaluation_only"}}}},{"if":{"properties":{"export":{"const":"training_allowed"}}},"then":{"properties":{"split":{"const":"training_development"}}}}]}
  }
}
