                    "kind": "field",
                    "value": "phase",
                    "type": "enum",
                    "domain": [
                      "cold",
                      "firing"
                    ]
                  },
                  "right": {
                    "kind": "literal",
                    "value": "firing",
                    "type": "enum",
                    "domain": [
                      "cold",
                      "firing"
                    ]
                  }
                },
                {
                  "op": "eq",
                  "left": {
                    "kind": "parameter",
                    "value": "value",
                    "type": "enum",
                    "domain": [
                      "open",
                      "closed"
                    ]
                  },
                  "right": {
                    "kind": "literal",
                    "value": "closed",
                    "type": "enum",
                    "domain": [
                      "open",
                      "closed"
                    ]
                  }
                }
              ]
            }
          },
          "error": "gate_locked"
        }
      ],
      "writes": {
        "vent": {
          "source": "input",
          "value": "value"
        }
      }
    },
    "cool": {
      "guards": [
        {
          "condition": {
            "op": "eq",
            "left": {
              "kind": "field",
              "value": "phase",
              "type": "enum",
