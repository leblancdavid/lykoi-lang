                "cold",
                "firing"
              ]
            },
            "right": {
              "kind": "literal",
              "value": "firing",
              "type": "enum",
              "domain": [
                "cold",
                "firing"
              ]
            }
          },
          "error": "invalid_transition"
        }
      ],
      "writes": {
        "phase": {
          "source": "literal",
          "value": "cold"
        }
      }
    },
    "rescue": {
      "guards": [
        {
          "condition": {
            "op": "eq",
            "left": {
              "kind": "field",
              "value": "phase",
              "type": "enum",
              "domain": [
                "cold",
                "firing"
              ]
            },
            "right": {
              "kind": "literal",
              "value": "cold",
              "type": "enum",
              "domain": [
                "cold",
                "firing"
              ]
            }
          },
          "error": "invalid_transition"
        },
        {
          "condition": {
            "op": "and",
            "children": [
              {
                "op": "eq",
                "left": {
                  "kind": "field",
                  "value": "vent",
                  "type": "enum",
                  "domain": [
                    "open",
                    "closed"
                  ]
                },
                "right": {
                  "kind": "literal",
                  "value": "closed",
                  "type": "enum",
                  "domain": [
                    "open",
                    "closed"
                  ]
                }
              },
              {
                "op": "eq",
                "left": {
                  "kind": "field",
                  "value": "load",
                  "type": "enum",
                  "domain": [
                    "ordinary",
                    "emergency"
                  ]
                },
                "right": {
                  "kind": "literal",
                  "value": "emergency",
                  "type": "enum",
                  "domain": [
                    "ordinary",
                    "emergency"
                  ]
                }
              }
            ]
          },
          "error": "exception_denied"
        }
      ],
      "writes": {
        "phase": {
          "source": "literal",
          "value": "firing"
        }
      }
    }
