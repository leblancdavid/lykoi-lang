      "writes": {
        "phase": {
          "source": "literal",
          "value": "cold"
        }
      }
    },
    "set_gate": {
      "guards": [
        {
          "condition": {
            "op": "not",
            "child": {
              "op": "and",
              "children": [
                {
                  "op": "eq",
