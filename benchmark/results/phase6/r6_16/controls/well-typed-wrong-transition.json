                "firing"
              ]
            }
          }
        },
        {
          "op": "eq",
          "left": {
            "kind": "field",
            "value": "vent",
            "type": "enum",
            "domain": [
              "open",
              "closed"
            ]
          },
          "right": {
            "kind": "literal",
            "value": "open",
            "type": "enum",
            "domain": [
              "open",
              "closed"
            ]
          }
        },
        {
          "op": "and",
          "children": [
            {
              "op": "eq",
