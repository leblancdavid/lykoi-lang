        "source": "literal",
        "value": "cold"
      },
      "vent": {
        "source": "input",
        "value": null
      },
      "load": {
        "source": "input",
        "value": null
      }
    },
    "nonblank": [
      "label"
    ]
  },
  "operations": {
    "ignite": {
      "guards": [
        {
          "condition": {
            "op": "eq",
            "left": {
              "kind": "field",
              "value": "phase",
              "type": "enum",
              "domain": [
                "cold",
                "firing"
              ]
            },
            "right": {
              "kind": "literal",
              "value": "cold",
              "type": "enum",
              "domain": [
                "cold",
                "firing"
              ]
            }
          },
          "error": "invalid_transition"
